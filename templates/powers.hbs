<section class="{{tab.tabCssClass}} powers sbs-powers" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{#if editable}}
    <div class="sbs-powers-add">
      <button type="button" data-sbs-power-action="timers"><i class="fa-solid fa-hourglass-half" inert></i> {{localize "swade-better-powers.UI.PowerTimers_967db5e745"}}</button>
    </div>
  {{/if}}
  {{#each sbsEntries}}
  <section class="sbs-spellcasting-entry" data-sbs-entry="{{id}}" data-arcane="{{arcane}}">
    <header class="section-header sbs-entry-header">
      <span class="name">{{name}}{{#if trait}}<small class="sbs-entry-trait">{{trait}}</small>{{/if}}</span>
      <span class="sbs-entry-controls">
        {{#if @root.editable}}<a role="button" tabindex="0" data-sbs-power-action="add" title="{{localize "swade-better-powers.UI.AddPower_47801ca8b2"}}" aria-label="Add Power to {{name}}"><i class="fa-solid fa-plus" inert></i></a><a role="button" tabindex="0" data-sbs-power-action="settings" title="{{localize "swade-better-powers.UI.Spellcastingsettings_6545c1a42a"}}" aria-label="Edit {{name}}"><i class="fa-solid fa-gear" inert></i></a>{{/if}}
        <label class="sbs-no-pp-label" data-tooltip="{{localize "swade-better-powers.UI.NoPowerPoints_fbaa49cd57"}}"><input type="checkbox" class="sbs-no-pp" aria-label="{{localize "swade-better-powers.UI.NoPowerPoints_fbaa49cd57"}}" {{checked noPP}} {{#unless @root.editable}}disabled{{/unless}}></label>
        {{#if noPP}}<span class="sbs-no-pp-text">{{localize "swade-better-powers.UI.NoPowerPointsenabled_aa897e88e0"}}</span>{{else}}
        <span class="pp-counter controls"><span>{{localize "swade-better-powers.UI.PP_91be13c5d6"}}</span><input type="number" name="system.powerPoints.{{arcane}}.value" value="{{value}}" aria-label="{{localize "swade-better-powers.UI.CurrentPowerPoints_b35cea952e"}}" {{#unless @root.editable}}disabled{{/unless}}>/<input type="number" name="system.powerPoints.{{arcane}}.max" value="{{max}}" aria-label="{{localize "swade-better-powers.UI.MaximumPowerPoints_3f97fe4e34"}}" {{#unless @root.editable}}disabled{{/unless}}>{{#if @root.editable}}<a role="button" tabindex="0" data-sbs-power-action="refresh" title="{{localize "swade-better-powers.UI.RefreshPowerPoints_7cbd1c644d"}}"><i class="fa-solid fa-arrows-rotate" inert></i></a>{{/if}}</span>
        {{/if}}
      </span>
    </header>
    <ul class="sbs-power-list unmarked-list">
      {{#each powers}}
      <li class="power item sbs-power" data-item-id="{{id}}" data-document-class="Item" draggable="true">
        <details>
          <summary class="power-header">
            <span class="sbs-native-chat-icon swade-official">
              <span class="inventory">
                <button type="button" class="item-img item-show sbs-power-icon" data-action="showItem" style="background-image: url('{{img}}');"
                  title="{{localize 'SWADE.ShowInChat'}}" aria-label="{{localize 'SWADE.ShowInChat'}}: {{name}}"></button>
              </span>
            </span>
            <a class="name item-name">{{name}}</a>{{#if @root.editable}}<span class="item-controls"><a role="button" tabindex="0" data-sbs-power-action="favorite" title="{{localize "swade-better-powers.UI.Favorite_ea713ecd85"}}"><i class="{{#if system.favorite}}fa-solid{{else}}fa-regular{{/if}} fa-star" inert></i></a><a role="button" tabindex="0" data-sbs-power-action="edit" title="{{localize "swade-better-powers.UI.Editpower_cb0751c217"}}"><i class="fa-solid fa-pen-to-square" inert></i></a></span>{{/if}}
          </summary>
        <div class="sbs-power-description">{{{description}}}</div>
        {{{modifierSummary}}}
        {{#if @root.editable}}<div class="sbs-power-card" data-item-id="{{id}}"><div class="sbs-casting-cost"><label>{{localize "swade-better-powers.UI.PPCost_33ae43b82c"}} <input class="pp-adjust" type="number" min="0" value="{{cost}}"></label>{{#unless ../noPP}}<a role="button" tabindex="0" data-sbs-power-action="pp-minus" title="{{localize "swade-better-powers.UI.SpendPowerPoints_e691f66454"}}"><i class="fa-solid fa-minus" inert></i></a><a role="button" tabindex="0" data-sbs-power-action="pp-plus" title="{{localize "swade-better-powers.UI.RefundPowerPoints_d4ea499167"}}"><i class="fa-solid fa-plus" inert></i></a>{{/unless}}{{#if ../noPP}}<label title="{{localize "swade-better-powers.UI.Eachmaintainedpowerapplies1to_9c64c37b46"}}"><input type="checkbox" class="sbs-maintained" {{checked maintained}}> {{localize "swade-better-powers.UI.Maintainpower_7b778cefd3"}}</label>{{/if}}</div>
        <div class="sbs-power-actions">{{#if system.actions.trait}}<button type="button" data-sbs-power-action="formula"><i class="fa-solid fa-hand-sparkles" inert></i> {{system.actions.trait}}</button>{{/if}}{{#if system.damage}}<button type="button" data-sbs-power-action="damage">{{system.damage}}</button>{{/if}}{{#each extraActions}}<button type="button" data-sbs-power-action="{{id}}">{{name}}</button>{{/each}}{{#each templates}}<button type="button" data-sbs-power-action="template" data-template="{{key}}">{{localize label}}</button>{{/each}}</div></div>{{/if}}
        </details>
      </li>
      {{else}}<li class="sbs-entry-empty">{{localize "swade-better-powers.UI.Dropapowerhereoruse_df132d7443"}}</li>{{/each}}
    </ul>
  </section>
  {{/each}}
</section>
