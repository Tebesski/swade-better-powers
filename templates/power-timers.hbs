<section class="standard-form">
  <fieldset>
    <legend>{{localize "swade-better-powers.UI.Startatimer_4f5f61681e"}}</legend>
    {{#if powers.length}}
      <div class="form-group">
        <label for="{{powerSelectId}}">{{localize "swade-better-powers.UI.Power_848e96567d"}}</label>
        <div class="form-fields">
          <select id="{{powerSelectId}}">{{selectOptions powers selected=selectedPower valueAttr="id" labelAttr="label"}}</select>
          <button type="button" data-action="startTimer"><i class="fa-solid fa-hourglass-start" inert></i> {{localize "swade-better-powers.UI.StartTimer_471c8546bc"}}</button>
        </div>
      </div>
    {{else}}
      <p class="hint">{{localize "swade-better-powers.UI.ThisactorneedsaNoPower_2553703dbe"}}</p>
    {{/if}}
  </fieldset>
  <fieldset>
    <legend>{{localize "swade-better-powers.UI.Trackedpowers_4d4c7218c2"}}</legend>
    <ol class="sbp-timer-list unmarked-list">
      {{#each timers}}
        <li>
          <img src="{{img}}" alt="">
          <div class="sbp-timer-details"><strong>{{name}}</strong><small>{{detail}}</small></div>
          <button type="button" data-action="editTimer" data-effect-id="{{id}}" aria-label="Edit timer for {{name}}" title="{{localize "swade-better-powers.UI.Editdurationandelapsedtime_58c61c2807"}}"><i class="fa-solid fa-pen" inert></i></button>
          <button type="button" data-action="stopTimer" data-effect-id="{{id}}" aria-label="Stop timer for {{name}}" title="{{localize "swade-better-powers.UI.Stoptimer_4b9d37eba6"}}"><i class="fa-solid fa-stop" inert></i></button>
        </li>
      {{else}}
        <li>{{localize "swade-better-powers.UI.Nopowertimers_46490a22a4"}}</li>
      {{/each}}
    </ol>
  </fieldset>
</section>
